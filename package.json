{
  "name": "greplogviewer",
  "displayName": "GrepLogViewer",
  "description": "Regex-based text file viewer with color highlighting and auto-folding",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/greplogviewer"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:greplogviewer.configView",
    "onCommand:greplogviewer.grepKeyword",
    "onCommand:greplogviewer.grepFunction",
    "onCommand:greplogviewer.addKeyword",
    "onCommand:greplogviewer.addDirToGroup",
    "onCommand:greplogviewer._testGo",
    "onCommand:greplogviewer._testClear",
    "onCommand:greplogviewer._testReset",
    "onCommand:greplogviewer._testGetState"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "greplogviewer.configView",
          "name": "GrepLogViewer",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "greplogviewer.grepKeyword",
        "title": "Grep Keyword"
      },
      {
        "command": "greplogviewer.grepFunction",
        "title": "Grep Function"
      },
      {
        "command": "greplogviewer.addKeyword",
        "title": "Add as Keyword"
      },
      {
        "command": "greplogviewer.addDirToGroup",
        "title": "Add to GrepLog Group Dirs"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "greplogviewer.grepKeyword",
          "when": "editorHasSelection",
          "group": "greplogviewer@1"
        },
        {
          "command": "greplogviewer.grepFunction",
          "when": "editorHasSelection",
          "group": "greplogviewer@2"
        },
        {
          "command": "greplogviewer.addKeyword",
          "when": "editorHasSelection",
          "group": "greplogviewer@3"
        }
      ],
      "explorer/context": [
        {
          "command": "greplogviewer.addDirToGroup",
          "when": "explorerResourceIsFolder",
          "group": "greplogviewer@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "ts-mocha test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^11.7.6",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.3.0"
  }
}
