{
  "name": "greplogviewer",
  "displayName": "Grep Log Viewer",
  "description": "Regex-based text file viewer with color highlighting and auto-folding",
  "version": "0.1.1",
  "publisher": "any-tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amw18/greplogviewer"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:greplogviewer.configView",
    "onView:greplogviewer.timelineView",
    "onCommand:greplogviewer.grepKeyword",
    "onCommand:greplogviewer.grepFunction",
    "onCommand:greplogviewer.addKeyword",
    "onCommand:greplogviewer._testGo",
    "onCommand:greplogviewer._testClear",
    "onCommand:greplogviewer._testReset",
    "onCommand:greplogviewer._testGetState",
    "onCommand:greplogviewer._testOpenFile",
    "onCommand:greplogviewer._testGetVisibleRanges"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "greplogviewer.configView",
          "name": "GrepLogViewer",
          "type": "webview"
        },
        {
          "id": "greplogviewer.timelineView",
          "name": "Keyword Timeline",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "greplogviewer.grepKeyword",
        "title": "Grep Keyword"
      },
      {
        "command": "greplogviewer.grepFunction",
        "title": "Grep Function"
      },
      {
        "command": "greplogviewer.addKeyword",
        "title": "Add as Keyword"
      },
      {
        "command": "greplogviewer._testOpenFile",
        "title": "Test Open File"
      },
      {
        "command": "greplogviewer._testGetVisibleRanges",
        "title": "Test Get Visible Ranges"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "greplogviewer.grepKeyword",
          "when": "editorHasSelection",
          "group": "greplogviewer@1"
        },
        {
          "command": "greplogviewer.grepFunction",
          "when": "editorHasSelection",
          "group": "greplogviewer@2"
        },
        {
          "command": "greplogviewer.addKeyword",
          "when": "editorHasSelection",
          "group": "greplogviewer@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "ts-mocha test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^11.7.6",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.3.0"
  }
}
