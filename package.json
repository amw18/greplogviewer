{
  "name": "log--",
  "displayName": "Grep Log Viewer",
  "description": "Regex-based text file viewer with color highlighting and auto-folding",
  "version": "0.2.14",
  "publisher": "any-tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amw18/log--"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:log--.configView",
    "onCommand:log--.grepKeyword",
    "onCommand:log--.grepFunction",
    "onCommand:log--.addKeyword",
    "onCommand:log--.gotoPrevHit",
    "onCommand:log--.gotoNextHit",
    "onCommand:log--._testGo",
    "onCommand:log--._testSyncConfig",
    "onCommand:log--._testClear",
    "onCommand:log--._testReset",
    "onCommand:log--._testGetState",
    "onCommand:log--._testOpenFile",
    "onCommand:log--._testGetVisibleRanges",
    "onCommand:log--._testGetTimelineData",
    "onCommand:log--._testGetRingBufferState"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "log--.configView",
          "name": "Log--",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "log--.grepKeyword",
        "title": "Grep Keyword"
      },
      {
        "command": "log--.grepFunction",
        "title": "Grep Function"
      },
      {
        "command": "log--.addKeyword",
        "title": "Add as Keyword"
      },
      {
        "command": "log--.gotoPrevHit",
        "title": "Goto Previous Hit"
      },
      {
        "command": "log--.gotoNextHit",
        "title": "Goto Next Hit"
      },
      {
        "command": "log--.exportMatchedLines",
        "title": "Export Matched Lines"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "log--.grepKeyword",
          "when": "editorHasSelection",
          "group": "log--@1"
        },
        {
          "command": "log--.grepFunction",
          "when": "editorHasSelection",
          "group": "log--@2"
        },
        {
          "command": "log--.addKeyword",
          "when": "editorHasSelection",
          "group": "log--@3"
        },
        {
          "command": "log--.gotoPrevHit",
          "group": "log--@4"
        },
        {
          "command": "log--.gotoNextHit",
          "group": "log--@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "ts-mocha test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^11.7.6",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.3.0"
  }
}
